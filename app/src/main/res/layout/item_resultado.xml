<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingTop="8dp" android:paddingBottom="12dp">
    <TextView android:id="@+id/nomeResultado" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="16sp" />
    <TextView android:id="@+id/contagemResultado" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textColor="@color/text_secondary"
        android:textSize="14sp" android:layout_marginTop="4dp" />
    <ProgressBar android:id="@+id/barraResultado" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="8dp"
        android:layout_marginTop="8dp" android:progressTint="@color/primary" android:max="100" />
</LinearLayout>
