<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="20dp">
        <TextView style="@style/Titulo" android:text="@string/titulo_pesquisa" />
        <TextView android:id="@+id/indicadorEtapa" style="@style/Descricao"
            android:textColor="@color/primary" android:accessibilityLiveRegion="polite" />
        <ProgressBar android:id="@+id/progressoEtapas" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="6dp" android:max="5"
            android:progressTint="@color/primary" android:layout_marginBottom="16dp" />
    </LinearLayout>
    <ScrollView android:id="@+id/rolagemPesquisa" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingBottom="20dp">
            <LinearLayout android:id="@+id/etapaEspontanea" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical">
                <TextView style="@style/Titulo" android:text="@string/espontanea" android:textSize="22sp" />
                <TextView style="@style/Descricao" android:text="@string/descricao_espontanea" />
                <com.google.android.material.textfield.TextInputLayout style="@style/Campo" android:hint="@string/voto_espontaneo">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/votoEspontaneo"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="textCapSentences" android:maxLength="100" android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/etapaEstimulada" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <TextView style="@style/Titulo" android:text="@string/estimulada" android:textSize="22sp" />
                <TextView style="@style/Descricao" android:text="@string/descricao_estimulada" />
                <RadioGroup android:id="@+id/opcoesVoto" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" android:saveEnabled="false" />
            </LinearLayout>
            <LinearLayout android:id="@+id/etapaProblemas" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <TextView style="@style/Titulo" android:text="@string/titulo_problemas" android:textSize="22sp" />
                <TextView style="@style/Descricao" android:text="@string/descricao_problemas" />
                <TextView android:id="@+id/contadorProblemas" style="@style/Descricao"
                    android:textColor="@color/primary" android:accessibilityLiveRegion="polite" />
                <LinearLayout android:id="@+id/opcoesProblemas" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" />
            </LinearLayout>
            <LinearLayout android:id="@+id/etapaDados" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <TextView style="@style/Titulo" android:text="@string/dados_entrevistado" android:textSize="22sp" />
                <TextView style="@style/Descricao" android:text="@string/descricao_dados" />
                <com.google.android.material.textfield.TextInputLayout style="@style/Campo" android:hint="@string/nome">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etname"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="textCapWords" android:maxLength="120" android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout style="@style/Campo" android:hint="@string/celular">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/celular"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="phone" android:maxLength="20" android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView style="@style/Descricao" android:text="@string/descricao_localizacao" android:textSize="14sp" />
                <TextView android:id="@+id/statusLocalizacao" style="@style/Descricao"
                    android:accessibilityLiveRegion="polite" />
                <com.google.android.material.button.MaterialButton android:id="@+id/obterLocalizacao"
                    style="@style/BotaoSecundario" android:text="@string/obter_localizacao" />
            </LinearLayout>
            <LinearLayout android:id="@+id/etapaConfirmacao" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <TextView style="@style/Titulo" android:text="@string/revisar" android:textSize="22sp" />
                <TextView style="@style/Descricao" android:text="@string/descricao_revisao" />
                <TextView android:id="@+id/resumoEntrevista" style="@style/Descricao"
                    android:textColor="@color/text_primary" android:lineSpacingExtra="6dp" android:textIsSelectable="true" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingBottom="12dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/voltarEtapa"
            style="@style/BotaoSecundario" android:layout_width="0dp" android:layout_weight="1" android:text="@string/voltar" />
        <com.google.android.material.button.MaterialButton android:id="@+id/continuarEtapa"
            style="@style/Botao" android:layout_width="0dp" android:layout_weight="1"
            android:layout_marginStart="12dp" android:text="@string/continuar" />
    </LinearLayout>
</LinearLayout>
